---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import layerMeta from '../../../data/layer-meta.json';
import { getCollection } from 'astro:content';
import { slugToTitle } from '../../../lib/titleCase';
import { extractDescription } from '../../../lib/extractDescription';

export async function getStaticPaths() {
  return layerMeta.map((layer) => ({
    params: { layer: layer.slug },
    props: { layer },
  }));
}

const { layer } = Astro.props;
const allLayerArtifacts = await getCollection('layers');
const artifacts = allLayerArtifacts
  .filter((e) => e.id.startsWith(`${layer.slug}/`))
  .sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout title={layer.title} description={layer.summary}>
  <article class="prose">
    <p class="eyebrow">Layer {layer.number}</p>
    <h1>{layer.title}</h1>
    <p class="lede">{layer.summary}</p>
  </article>

  <ul class="artifact-list">
    {artifacts.map((entry) => {
      const [, ...rest] = entry.id.split('/');
      const slug = rest.join('/');
      const firstH1 = entry.body?.match(/^#\s+(.+)$/m)?.[1]?.trim();
      const title = entry.data.title ?? firstH1 ?? slugToTitle(slug);
      const description = extractDescription(entry.body);
      return (
        <li>
          <a href={`/layers/${layer.slug}/${slug}`} class="artifact-card">
            <h3>{title}</h3>
            {description && <p class="description">{description}</p>}
            <span class="arrow">→</span>
          </a>
        </li>
      );
    })}
  </ul>

  {artifacts.length === 0 && (
    <p class="empty">No artifacts yet in this layer.</p>
  )}
</BaseLayout>

<style>
  .eyebrow {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin: 0 0 0.25rem;
  }
  .lede {
    font-size: 1.05rem;
    color: var(--color-text-muted);
  }
  .artifact-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.85rem;
  }
  .artifact-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.15rem 1.15rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 150ms ease, transform 150ms ease;
    height: 100%;
  }
  .artifact-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }
  .artifact-card h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .description {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    flex: 1;
  }
  .arrow {
    color: var(--color-primary);
    font-size: 1rem;
    align-self: flex-end;
    margin-top: 0.25rem;
  }
  .empty {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
