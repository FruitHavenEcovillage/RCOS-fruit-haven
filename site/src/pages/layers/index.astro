---
import BaseLayout from '../../layouts/BaseLayout.astro';
import layerMeta from '../../data/layer-meta.json';
---

<BaseLayout title="Layers" description="The seven layers of the EcoHubs community.">
  <article class="prose">
    <p class="eyebrow">Primary content</p>
    <h1>The RCOS artifacts</h1>
    <p>
      These pages contain the artifacts - the outcome of applying RCOS to the EcoHubs community - structured in seven layers. Each layer answers one foundational question the community must resolve.
      They build on each other — identity before membership, membership before
      governance, and so on up through evolution.
    </p>
  </article>

  <ul class="layer-grid">
    {layerMeta.map((layer) => (
      <li>
        <a href={`/layers/${layer.slug}`} class="layer-card">
          <span class="num">Layer {layer.number}</span>
          <h2>{layer.title}</h2>
          <p>{layer.summary}</p>
          <span class="arrow">→</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .eyebrow {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin: 0 0 0.25rem;
  }
  .layer-grid {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .layer-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-text);
    position: relative;
    height: 100%;
    transition: border-color 150ms ease, transform 150ms ease;
  }
  .layer-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }
  .num {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }
  .layer-card h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .layer-card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    flex: 1;
  }
  .arrow {
    color: var(--color-primary);
    font-size: 1.1rem;
    align-self: flex-end;
  }
  @media (max-width: 560px) {
    .layer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
