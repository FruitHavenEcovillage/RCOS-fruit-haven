---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Unauthorized" description="Access Denied">
  <section class="cms-head">
    <div>
      <p class="eyebrow">GitHub CMS</p>
      <h1>Access Denied</h1>
      <p class="error-msg">
        please ask admin to add you to the fruithavenecovillage orgnization editor team on github
      </p>
      <br/>
      <a class="back-link" href="/cms">Back to CMS</a>
    </div>
  </section>
</BaseLayout>

<style>
  .cms-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .cms-head h1 {
    margin: 0.1rem 0 0.5rem;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 2.7rem);
    color: var(--color-danger, #d32f2f);
  }
  .error-msg {
    max-width: 42rem;
    margin: 0;
    color: var(--color-text);
    font-size: 1.1rem;
    font-weight: 500;
  }
  .eyebrow {
    text-transform: uppercase;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    font-weight: 700;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.9rem;
    margin-top: 1rem;
  }
</style>
