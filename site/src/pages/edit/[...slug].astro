---
import { getSession } from 'auth-astro/server';
import authConfig from '../../../auth.config.mjs';
import Editor from '../../components/Editor.svelte';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAuthEnvStatus } from '../../lib/auth-env';
import { cmsConfig, getGitHubFileUrl, isEditableMarkdownPath } from '../../lib/cms-config';

export const prerender = false;

let session = null;
let initialContent = '';
let errorMessage = null;
let errorStack = null;
let missingEnv = [];
const { slug } = Astro.params;
const path = slug || '';
const callbackUrl = Astro.url.href;
const signInUrl = `/api/auth/signin?callbackUrl=${encodeURIComponent(callbackUrl)}`;
const signOutUrl = `/api/auth/signout?callbackUrl=${encodeURIComponent('/cms')}`;

try {
  const authEnv = getAuthEnvStatus();
  missingEnv = authEnv.missing;

  if (!isEditableMarkdownPath(path)) {
    errorMessage = path
      ? `This CMS can only edit Markdown files in layers/, proposals/, compliance/, or README.md. Requested: ${path}`
      : 'Choose a document from the CMS dashboard before editing.';
  }

  if (!authEnv.isConfigured) {
    errorMessage = `GitHub OAuth is not configured. Missing: ${missingEnv.join(', ')}`;
  } else if (!errorMessage) {
    session = await getSession(Astro.request, authConfig);
  }

  if (session && session.accessToken) {
    const fileUrl = getGitHubFileUrl(path);
    
    const res = await fetch(fileUrl, {
      headers: {
        Authorization: `Bearer ${session.accessToken}`,
        Accept: 'application/vnd.github.v3+json',
      }
    });

    if (res.ok) {
      const data = await res.json();
      initialContent = new TextDecoder().decode(
        Uint8Array.from(atob(data.content.replace(/\n/g, '')), (char) => char.charCodeAt(0)),
      );
    } else {
      console.error(`File ${path} not found or inaccessible`);
      initialContent = `# New Document\n\nStart typing here...`;
    }
  }
} catch (err: any) {
  console.error("Failed to load page data:", err);
  errorMessage = err.message || String(err);
  errorStack = err.stack || '';
}
---

<BaseLayout title="Edit document" description="Edit Fruit Haven RCOS content.">
  <section class="edit-head">
    <div>
      <p class="eyebrow">GitHub CMS</p>
      <h1>WYSIWYG editor</h1>
      <p>
        Target: <code>{cmsConfig.owner}/{cmsConfig.repo}</code> on <code>{cmsConfig.branch}</code>.
      </p>
    </div>
    <div class="session-panel">
      <a href="/cms">All documents</a>
      {session ? (
        <>
          <span>Signed in as <strong>{session.user?.name || session.user?.email}</strong></span>
          <a href={signOutUrl}>Sign out</a>
        </>
      ) : !errorMessage ? (
        <a class="login" href={signInUrl}>Login with GitHub</a>
      ) : null}
    </div>
  </section>

  {errorMessage && (
    <div class="notice danger">
      <h2>Editor unavailable</h2>
      <p>{errorMessage}</p>
      {errorStack && (
        <details>
          <summary>View stack trace</summary>
          <pre>{errorStack}</pre>
        </details>
      )}
      {missingEnv.length > 0 && (
        <p>
          Configure <code>{missingEnv.join(', ')}</code>, plus <code>AUTH_SECRET</code> in deployment.
        </p>
      )}
    </div>
  )}

  {!errorMessage && session ? (
    <div>
      <p class="editing-path">Editing <code>{path}</code></p>
      <Editor client:only="svelte" content={initialContent} path={path} />
    </div>
  ) : !errorMessage ? (
    <div class="login-panel">
      <h2>Authentication required</h2>
      <p>Use a GitHub account with write access to edit and commit repository content.</p>
      <a class="login" href={signInUrl}>Login with GitHub</a>
    </div>
  ) : null}

  <style>
    .edit-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1.5rem;
      margin-bottom: 1.25rem;
    }
    .edit-head h1 {
      margin: 0.1rem 0 0.4rem;
      font-family: var(--font-heading);
      font-size: clamp(2rem, 5vw, 2.7rem);
      color: var(--color-primary-dark);
    }
    .edit-head p,
    .editing-path,
    .login-panel p {
      color: var(--color-text-muted);
      margin: 0;
    }
    .eyebrow {
      margin: 0;
      text-transform: uppercase;
      font-size: 0.74rem;
      letter-spacing: 0.08em;
      color: var(--color-primary);
      font-weight: 700;
    }
    .session-panel {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      flex-wrap: wrap;
      justify-content: flex-end;
      font-size: 0.9rem;
      color: var(--color-text-muted);
    }
    .session-panel a,
    .login {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.25rem;
      padding: 0.45rem 0.75rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: var(--color-surface);
      color: var(--color-text);
      text-decoration: none;
      font-size: 0.9rem;
    }
    .login {
      border-color: var(--color-primary);
      background: var(--color-primary);
      color: var(--color-surface);
    }
    .editing-path {
      margin-bottom: 0.85rem;
    }
    code {
      font-family: var(--font-mono);
      font-size: 0.86em;
      background: var(--color-surface-muted);
      padding: 0.12em 0.35em;
      border-radius: var(--radius-sm);
    }
    .notice,
    .login-panel {
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-surface);
      padding: 1.25rem;
    }
    .notice.danger {
      border-color: color-mix(in srgb, var(--color-danger) 50%, var(--color-border));
      color: var(--color-danger);
    }
    .notice h2,
    .login-panel h2 {
      margin: 0 0 0.45rem;
      font-size: 1.25rem;
      color: var(--color-text);
    }
    .notice pre {
      overflow-x: auto;
      white-space: pre-wrap;
      background: var(--color-surface-muted);
      padding: 0.75rem;
      border-radius: var(--radius-sm);
    }
    .login-panel {
      display: grid;
      gap: 0.75rem;
      justify-items: start;
      max-width: 36rem;
    }
    @media (max-width: 720px) {
      .edit-head {
        flex-direction: column;
      }
      .session-panel {
        justify-content: flex-start;
      }
    }
  </style>
</BaseLayout>
