---
import DocLayout from '../layouts/DocLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('compliance', 'checklist');
if (!entry) throw new Error('compliance/checklist.md not found');
const { Content } = await render(entry);

const body = entry.body ?? '';
const total = (body.match(/^[-*] \[[ xX]\]/gm) ?? []).length;
const checked = (body.match(/^[-*] \[[xX]\]/gm) ?? []).length;
const pct = total > 0 ? Math.round((checked / total) * 100) : 0;
---

<DocLayout
  title="Compliance checklist"
  description="RCOS compliance status for the EcoHubs community."
  eyebrow="Compliance"
>
  {total > 0 && (
    <div class="status">
      <div class="status-row">
        <strong>{checked}</strong><span>of {total} items checked ({pct}%)</span>
      </div>
      <div class="progress" role="progressbar" aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style={`width: ${pct}%`}></div>
      </div>
    </div>
  )}
  <Content />
</DocLayout>

<style>
  .status {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    margin-bottom: 1.5rem;
  }
  .status-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .status-row strong {
    font-size: 1.4rem;
  }
  .status-row span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .progress {
    width: 100%;
    height: 0.5rem;
    background: var(--color-surface-muted);
    border-radius: 999px;
    overflow: hidden;
  }
  .progress-bar {
    height: 100%;
    background: var(--color-primary);
  }
</style>
