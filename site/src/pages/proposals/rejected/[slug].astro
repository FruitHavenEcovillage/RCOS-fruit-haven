---
import DocLayout from '../../../layouts/DocLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('proposals', (e) => e.data.status === 'rejected');
  return entries.map((entry) => ({
    params: { slug: entry.id.split('/').pop()! },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.date.toISOString().slice(0, 10);
---

<DocLayout
  title={entry.data.title}
  description={entry.data.summary}
  eyebrow={`Rejected · ${date}`}
>
  <p class="summary">{entry.data.summary}</p>
  <dl class="facts">
    <dt>Decision type</dt><dd>{entry.data.decision_type}</dd>
    <dt>Layers affected</dt><dd>{entry.data.layers.map((n) => `L${n}`).join(', ')}</dd>
    {entry.data.vote_result && (<><dt>Vote</dt><dd>{entry.data.vote_result}</dd></>)}
  </dl>
  <hr />
  <Content />
  <hr />
  <p class="back"><a href="/proposals/rejected">← All rejected proposals</a></p>
</DocLayout>

<style>
  .summary {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: 1rem;
  }
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    margin: 0;
    font-size: 0.9rem;
  }
  .facts dt {
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .facts dd {
    margin: 0;
  }
  .back {
    font-size: 0.9rem;
  }
</style>
