---
import DocLayout from '../../../layouts/DocLayout.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('future', (entry) => entry.id.startsWith('future/'));
  return entries.map((entry) => ({
    params: { slug: entry.id.split('/').pop()! },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = entry.body.match(/^#\s+Proposal:\s+(.+)$/m)?.[1] ?? 'Future proposal';
---

<DocLayout
  title={title}
  description="Draft or deferred proposal for a future governance decision."
  eyebrow="Future proposal"
>
  <Content />
  <hr />
  <p class="back"><a href="/proposals/future">Back to future proposals</a></p>
</DocLayout>

<style>
  .back {
    font-size: 0.9rem;
  }
</style>
