---
import { getCollection, getEntry } from 'astro:content';
import highlights from '../data/highlights.json';
import layerMeta from '../data/layer-meta.json';

const allProposals = await getCollection('proposals');
const latestProposals = allProposals
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const compliance = await getEntry('compliance', 'checklist');
const complianceBody = compliance?.body ?? '';
const totalBoxes = (complianceBody.match(/^[-*] \[[ xX]\]/gm) ?? []).length;
const checkedBoxes = (complianceBody.match(/^[-*] \[[xX]\]/gm) ?? []).length;
const compliancePct =
  totalBoxes > 0 ? Math.round((checkedBoxes / totalBoxes) * 100) : 0;

const layerByNumber = Object.fromEntries(layerMeta.map((l) => [l.number, l]));
---

<section class="tiles" aria-label="Dashboard">
  <article class="tile">
    <header>
      <h3>Compliance</h3>
      <span class="muted">RCOS checklist</span>
    </header>
    {totalBoxes > 0 ? (
      <>
        <div class="progress" role="progressbar" aria-valuenow={compliancePct} aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar" style={`width: ${compliancePct}%`}></div>
        </div>
        <p class="stat">
          <strong>{checkedBoxes}</strong> of {totalBoxes} items ({compliancePct}%)
        </p>
      </>
    ) : (
      <p class="muted">No checklist items parsed.</p>
    )}
    <a href="/compliance" class="tile-link">View checklist →</a>
  </article>

  <article class="tile">
    <header>
      <h3>Latest proposals</h3>
      <span class="muted">Passed & rejected</span>
    </header>
    {latestProposals.length > 0 ? (
      <ul class="proposal-list">
        {latestProposals.map((p) => (
          <li>
            <a href={`/proposals/${p.data.status}/${p.id.split('/').pop()}`}>
              <span class={`badge badge-${p.data.status}`}>{p.data.status}</span>
              <span class="proposal-title">{p.data.title}</span>
            </a>
            <span class="date">{p.data.date.toISOString().slice(0, 10)}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">No proposals decided yet.</p>
    )}
    <a href="/proposals/passed" class="tile-link">Browse all →</a>
  </article>

  <article class="tile tile-wide">
    <header>
      <h3>Active layer highlights</h3>
      <span class="muted">Recent updates</span>
    </header>
    <ul class="highlight-list">
      {highlights.tiles.map((h) => {
        const layer = layerByNumber[h.layer];
        return (
          <li>
            <a href={layer ? `/layers/${layer.slug}` : '#'} class="highlight">
              <span class="chip">Layer {h.layer}</span>
              <span class="highlight-body">
                <strong>{h.title}</strong>
                <span>{h.body}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </article>
</section>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2.5rem;
  }
  .tile-wide {
    grid-column: 1 / -1;
  }
  @media (max-width: 720px) {
    .tiles {
      grid-template-columns: 1fr;
    }
  }
  .tile {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    box-shadow: var(--shadow-sm);
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
  }
  .tile:hover {
    border-color: color-mix(in srgb, var(--color-primary) 40%, transparent);
    box-shadow: 0 10px 24px -14px color-mix(in srgb, var(--color-primary) 35%, transparent);
  }
  .tile header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .tile h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    letter-spacing: -0.01em;
  }
  @media (prefers-color-scheme: dark) {
    .tile h3 { color: var(--color-primary); }
  }
  .muted {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }
  .progress {
    width: 100%;
    height: 0.5rem;
    background: var(--color-surface-muted);
    border-radius: 999px;
    overflow: hidden;
  }
  .progress-bar {
    height: 100%;
    background: var(--color-primary);
    transition: width 300ms ease;
  }
  .stat {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .stat strong {
    color: var(--color-text);
    font-size: 1.1rem;
  }
  .tile-link {
    margin-top: auto;
    font-size: 0.85rem;
    text-decoration: none;
  }
  .proposal-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .proposal-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.9rem;
  }
  .proposal-list a {
    text-decoration: none;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .proposal-list a:hover .proposal-title {
    color: var(--color-primary);
  }
  .proposal-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .badge {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
  }
  .badge-passed {
    color: var(--color-primary);
    border-color: color-mix(in srgb, var(--color-primary) 40%, transparent);
  }
  .badge-rejected {
    color: var(--color-danger);
    border-color: color-mix(in srgb, var(--color-danger) 40%, transparent);
  }
  .date {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
  }
  .highlight-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }
  .highlight {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-muted);
    text-decoration: none;
    color: var(--color-text);
  }
  .highlight:hover {
    border-color: var(--color-primary);
  }
  .chip {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
  }
  .highlight-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .highlight-body span {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }
</style>
